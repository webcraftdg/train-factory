<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %} {{ app.request.attributes.get('page_title')|default('Usine à Entrainements') }}{% endblock %}</title>
        <link rel="icon"  type="image/svg+xml" href="{{ asset('icons/logo.svg') }}">
         {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
         <base href="/">

        <link rel="stylesheet" href="{{ angular_asset('styles', 'css') }}">
    </head>
    <body>
            {% block body %}
                <app-root></app-root>
                  <script
                    type="module"
                    src="{{ angular_asset('main', 'js') }}">
                </script>
            {% endblock %}
    </body>
</html>
