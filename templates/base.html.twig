<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %} {{ app.request.attributes.get('page_title')|default('Usine à Entrainements') }}{% endblock %}</title>
        <link rel="icon"  type="image/svg+xml" href="{{ asset('icons/logo.svg') }}">
         {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
         <base href="/">

        <link rel="stylesheet" href="{{ asset('angular/styles.css') }}">
    </head>
    <body class="flex min-h-screen flex-col bg-slate-100">
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
            {% block body %}
                <app-root></app-root>

                <script type="module" src="{{ asset('angular/main.js') }}"></script>
            {% endblock %}
        </main>

    </body>
</html>
