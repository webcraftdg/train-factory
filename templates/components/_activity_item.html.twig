
<details class="group overflow-hidden rounded-xl
                border border-slate-200 bg-white
                shadow-sm transition-shadow
                open:shadow-md"
    data-controller="archived"
    data-archived-context-name-value="{{ activity.name}}"
                >

    {# Version réduite #}
    <summary class="flex cursor-pointer list-none
                    flex-col gap-3 px-4 py-4
                    hover:bg-slate-50
                    sm:px-6
                    [&::-webkit-details-marker]:hidden">

        <div class="flex items-start justify-between gap-4">

            <div class="min-w-0 flex-1">

                <div class="flex flex-wrap items-center gap-3">

                    <h2 class="text-base font-semibold
                               text-slate-900">
                        {{ activity.name }}
                    </h2>

                    {% if activity.duration is not empty %}
                        <span class="rounded-md bg-blue-50
                                     px-2.5 py-1 text-xs
                                     font-medium text-blue-700">
                            Durée : {{ activity.duration }}
                        </span>
                    {% endif %}
                    {% if activity.hydration %}
                        <span class="inline-flex items-center gap-1.5 rounded-md
                                    bg-cyan-50 px-2.5 py-1 text-xs font-medium
                                    text-cyan-700 ring-1 ring-inset ring-cyan-200"
                            title="Pause hydratation de 2 minutes">

                            <i
                                data-controller="svg"
                                data-svg-name-value="goutte"
                                data-svg-width-value="20"
                                data-svg-height-value="20"
                                aria-hidden="true"></i>
                            Hydratation +2 min
                        </span>
                    {% endif %}



                    <span class="rounded-md bg-slate-100
                                 px-2.5 py-1 text-xs
                                 font-medium text-slate-600">
                        {{ activity.exercises|length }}
                        exercice(s)
                    </span>

                </div>

                {% if activity.description is not empty %}
                    <p class="mt-2 line-clamp-2 text-sm
                              leading-6 text-slate-600
                              group-open:hidden">
                        {{ activity.description }}
                    </p>
                {% endif %}

            </div>

            <div class="flex shrink-0 items-center gap-2
                        text-sm font-medium text-blue-600">
                 <a href="{{ path('app_activity_edit', {id: activity.id}) }}"
                    aria-label="Modifier {{ activity.name }}"
                    title="Modifier {{ activity.name }}"
                    onclick="event.stopPropagation()"
                    class="inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50">

                    <span data-controller="svg"
                        data-svg-name-value="edit"
                        class="inline-flex items-center justify-center"
                        aria-hidden="true">
                    </span>
                </a>
                {% if (is_granted('ROLE_ADMIN') and activity.canBeArchived) %}
                    <a href="{{ path('app_activity_archived', {id: activity.id}) }}"
                        data-action="click->archived#confirmDelete"
                        data-turbo-prefetch="false"
                        aria-label="Archiver {{ activity.name }}"
                        title="Archiver {{ activity.name }}"
                        class="inline-flex min-h-10 items-center gap-2
                                rounded-lg px-3 py-2 font-medium
                                text-orange-600 hover:bg-orange-50">
                        <span data-controller="svg"
                            data-svg-name-value="archive"
                            class="inline-flex  items-center justify-center"
                            aria-hidden="true">
                        </span>
                    </a>
                {% endif %}


                <span class="hidden sm:inline group-open:hidden">
                    Déployer
                </span>

                <span class="hidden group-open:sm:inline">
                    Réduire
                </span>

                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-5 w-5 transition-transform
                            duration-200 group-open:rotate-180"
                     fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m6 9 6 6 6-6"/>
                </svg>

            </div>

        </div>

    </summary>

    {# Version étendue #}
    <div class="border-t border-slate-100 px-4
                py-5 sm:px-6">

        <div class="grid grid-cols-1 gap-8
                    lg:grid-cols-2 lg:gap-10">

            {# Informations générales #}
            <div class="space-y-6">

                <div>
                    <h3 class="mb-2 text-xs font-bold
                               uppercase tracking-wider
                               text-slate-500">
                        Description
                    </h3>

                    <p class="whitespace-pre-line text-sm
                              leading-7 text-slate-700">{{ activity.description|default('Aucune description renseignée.') }}</p>
                </div>

                {% if activity.objective is not empty %}
                    <div>
                        <h3 class="mb-2 text-xs font-bold
                                   uppercase tracking-wider
                                   text-slate-500">
                            Objectif
                        </h3>

                        <p class="whitespace-pre-line text-sm
                                  leading-7 text-slate-700">{{ activity.objective }}</p>
                    </div>
                {% endif %}

                {% if activity.instruction is not empty %}
                    <div>
                        <h3 class="mb-2 text-xs font-bold
                                   uppercase tracking-wider
                                   text-slate-500">
                            Consignes générales
                        </h3>

                        <p class="whitespace-pre-line text-sm
                                  leading-7 text-slate-700">{{ activity.instruction }}</p>
                    </div>
                {% endif %}

            </div>

            {# Exercices associés #}
            <div>
                <h3 class="mb-4 text-xs font-bold
                           uppercase tracking-wider
                           text-slate-500">
                    Exercices associés
                    ({{ activity.exercises|length }})
                </h3>

                {% if activity.exercises is not empty %}

                    <div class="space-y-3">

                        {% for exercise in activity.exercises %}

                            <div class="rounded-lg border
                                        border-slate-200
                                        bg-slate-50 p-4">

                                <div class="mb-2 flex
                                            items-start gap-3">

                                    <span class="flex h-6 w-6
                                                 shrink-0 items-center
                                                 justify-center
                                                 rounded-full bg-blue-100
                                                 text-xs font-bold
                                                 text-blue-700">
                                        {{ loop.index }}
                                    </span>

                                    <h4 class="font-semibold
                                               text-slate-900">
                                        {{ exercise.name }}
                                    </h4>

                                </div>

                                {% if exercise.description is not empty %}
                                    <div class="pl-9">
                                        <p class="mb-1 text-xs
                                                  font-semibold
                                                  text-slate-500">
                                            Consigne
                                        </p>

                                        <p class="whitespace-pre-line
                                                  text-sm leading-6
                                                  text-slate-700">{{ exercise.description }}</p>
                                    </div>
                                {% endif %}

                            </div>

                        {% endfor %}

                    </div>

                {% else %}

                    <p class="text-sm text-slate-500">
                        Aucun exercice associé.
                    </p>

                {% endif %}

            </div>

        </div>
    </div>

</details>
