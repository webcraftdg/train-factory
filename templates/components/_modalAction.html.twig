<dialog
    data-controller="modal-action"
    data-modal-action-target="dialog"
    data-modal-action-event-name-value="items-selector_update"
    data-action="button-action:open-modal@window->modal-action#open"
    aria-labelledby="items-modal-title"
    class="fixed inset-0 m-auto
        w-[calc(100%-2rem)] max-w-xl
        h-fit max-h-[calc(100dvh-2rem)]
        overflow-y-auto
        rounded-2xl bg-white p-0
        text-slate-800 shadow-2xl
        backdrop:bg-slate-950/60
        backdrop:backdrop-blur-[2px]"
>
    <div class="relative w-full">

        {# Bouton de fermeture #}
        <button
            type="button"
            data-action="click->modal-action#close"
            aria-label="Fermer"
            class="absolute right-4 top-4 z-10
                flex h-9 w-9 items-center justify-center
                rounded-full text-slate-400
                transition hover:bg-slate-100
                hover:text-slate-700
                focus:outline-none focus:ring-2
                focus:ring-blue-500"
        >
            <span data-controller="svg"
            data-svg-name-value="close"
            class="inline-flex  h-5 w-5 items-center justify-center"
            aria-hidden="true">
        </button>
        <div data-modal-action-target="content">

        </div>
    </div>
</dialog>
