
{{ form_start(form, {
    action:action,
    attr: {
        class: 'space-y-6'
    }
}) }}

<div class="overflow-hidden rounded-xl border border-slate-200
            bg-white shadow-sm">

    {# En-tête du formulaire #}
    <div class="flex items-center gap-4 border-b border-slate-100
                px-5 py-5 sm:px-7">

        <div class="flex h-12 w-12 shrink-0 items-center
                    justify-center rounded-xl bg-blue-600
                    text-blue-600">

             <span data-controller="svg"
                data-svg-name-value="haltere"
                class="h-6 w-6 inline-flex  items-center justify-center"
                aria-hidden="true">
            </span>
        </div>

        <div class="min-w-0">
            <h2 class="text-lg font-semibold text-slate-900">
                {{ form_title|default('Informations de l’exercice') }}
            </h2>

            <p class="mt-1 text-sm text-slate-500">
                Renseignez les caractéristiques de votre exercice.
            </p>
        </div>
    </div>

    {# Champs #}
    <div class="space-y-6 px-5 py-6 sm:px-7">

        {{ form_errors(form) }}

        <div>
            {{ form_label(form.name, null, {
                label_attr: {
                    class: 'mb-2 block text-sm font-medium text-slate-700'
                }
            }) }}

            {{ form_widget(form.name, {
                attr: {
                    class: 'block w-full rounded-lg border border-slate-300
                            bg-white px-4 py-3 text-slate-900
                            placeholder:text-slate-400
                            focus:border-blue-500 focus:outline-none
                            focus:ring-2 focus:ring-blue-500/20',
                    placeholder: 'Ex. : Direct avant + fouetté arrière'
                }
            }) }}

            <div class="mt-1 text-sm text-red-600">
                {{ form_errors(form.name) }}
            </div>
        </div>

        <div>
            {{ form_label(form.description, null, {
                label_attr: {
                    class: 'mb-2 block text-sm font-medium text-slate-700'
                }
            }) }}

            {{ form_widget(form.description, {
                attr: {
                    rows: 5,
                    class: 'block w-full resize-y rounded-lg
                            border border-slate-300 bg-white
                            px-4 py-3 text-slate-900
                            placeholder:text-slate-400
                            focus:border-blue-500 focus:outline-none
                            focus:ring-2 focus:ring-blue-500/20',
                    placeholder: 'Décrivez les consignes de l’exercice...'
                }
            }) }}

            <p class="mt-2 text-xs text-slate-500">
                Précisez les consignes techniques et les points de vigilance.
            </p>

            <div class="mt-1 text-sm text-red-600">
                {{ form_errors(form.description) }}
            </div>
        </div>

    </div>

    {# Actions #}
    <div class="flex flex-col-reverse gap-3 border-t border-slate-100
                bg-slate-50 px-5 py-4
                sm:flex-row sm:items-center sm:justify-end sm:px-7">

        <a href="{{ cancel_url|default(path('app_exercise_index')) }}"
           class="inline-flex min-h-11 items-center justify-center
                  rounded-lg border border-slate-300 bg-white
                  px-5 py-2.5 text-sm font-medium text-slate-700
                  transition-colors hover:bg-slate-100">
            Annuler
        </a>

        <button type="submit"
                class="inline-flex min-h-11 items-center justify-center
                       gap-2 rounded-lg bg-blue-600 px-5 py-2.5
                       text-sm font-semibold text-white
                       transition-colors hover:bg-blue-700
                       focus-visible:outline-2
                       focus-visible:outline-offset-2
                       focus-visible:outline-blue-600">

            {{ button_label|default('Enregistrer') }}
        </button>
    </div>

</div>

{{ form_end(form) }}
