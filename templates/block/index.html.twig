{% extends 'base.html.twig' %}

{% block title %}Block index{% endblock %}

{% block body %}
    <h1>Block index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Objective</th>
                <th>Instruction</th>
                <th>Duration</th>
                <th>DateArchived</th>
                <th>DateCreate</th>
                <th>DateUpdate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for block in blocks %}
            <tr>
                <td>{{ block.id }}</td>
                <td>{{ block.name }}</td>
                <td>{{ block.description }}</td>
                <td>{{ block.objective }}</td>
                <td>{{ block.instruction }}</td>
                <td>{{ block.duration }}</td>
                <td>{{ block.dateArchived ? block.dateArchived|date('Y-m-d') : '' }}</td>
                <td>{{ block.dateCreate ? block.dateCreate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ block.dateUpdate ? block.dateUpdate|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_block_show', {'id': block.id}) }}">show</a>
                    <a href="{{ path('app_block_edit', {'id': block.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_block_new') }}">Create new</a>
{% endblock %}
