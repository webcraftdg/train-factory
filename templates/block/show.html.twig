{% extends 'base.html.twig' %}

{% block title %}Block{% endblock %}

{% block body %}
    <h1>Block</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ block.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ block.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ block.description }}</td>
            </tr>
            <tr>
                <th>Objective</th>
                <td>{{ block.objective }}</td>
            </tr>
            <tr>
                <th>Instruction</th>
                <td>{{ block.instruction }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ block.duration }}</td>
            </tr>
            <tr>
                <th>DateArchived</th>
                <td>{{ block.dateArchived ? block.dateArchived|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateCreate</th>
                <td>{{ block.dateCreate ? block.dateCreate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateUpdate</th>
                <td>{{ block.dateUpdate ? block.dateUpdate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_block_index') }}">back to list</a>

    <a href="{{ path('app_block_edit', {'id': block.id}) }}">edit</a>

    {{ include('block/_delete_form.html.twig') }}
{% endblock %}
