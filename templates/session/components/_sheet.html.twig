<main class="tf-shell" data-controller="savate-sheet">
  <div class="tf-top"><div><p class="tf-eyebrow">TRAINFACTORY / SAVATE BOXE FRANÇAISE</p><h1>Préparer une séance</h1><p>Remplissez directement votre fiche, comme sur papier.</p></div><span class="tf-state">Brouillon non enregistré</span></div>
  <div class="tf-alert" data-savate-sheet-target="errors" role="alert" tabindex="-1" hidden></div>
  <div class="tf-sheet">
    <div class="tf-theme"><label for="tf-theme">THÈME</label><textarea id="tf-theme" rows="2" data-field="theme" placeholder="Ex. Gant vert : je ne suis pas touché et je touche — travail de tournant">Gant vert : je ne suis pas touché et je touche — travail de tournant</textarea></div>
    <div class="tf-salut">SALUT</div>
    <div data-savate-sheet-target="blocks" class="tf-blocks"></div>
    <button class="tf-add tf-add-block" type="button" data-action="click->savate-sheet#addBlock">＋ Ajouter une partie de séance</button>
    <div class="tf-salut">SALUT</div>
  </div>
  <div class="tf-actions"><span data-savate-sheet-target="status" aria-live="polite">Les modifications restent locales jusqu'à l'enregistrement.</span><button type="button" class="tf-save" data-action="click->savate-sheet#save">Enregistrer la séance</button></div>
  {% include 'session/components/_prototypes.html.twig' %}
</main>
