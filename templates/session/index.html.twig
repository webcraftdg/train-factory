{% extends 'base.html.twig' %}

{% block title %}Session index{% endblock %}

{% block body %}
    <h1>Session index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Target</th>
                <th>Duration</th>
                <th>DateArchived</th>
                <th>DateCreate</th>
                <th>DateUpdate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for session in sessions %}
            <tr>
                <td>{{ session.id }}</td>
                <td>{{ session.name }}</td>
                <td>{{ session.description }}</td>
                <td>{{ session.target }}</td>
                <td>{{ session.duration }}</td>
                <td>{{ session.dateArchived ? session.dateArchived|date('Y-m-d') : '' }}</td>
                <td>{{ session.dateCreate ? session.dateCreate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ session.dateUpdate ? session.dateUpdate|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_session_show', {'id': session.id}) }}">show</a>
                    <a href="{{ path('app_session_edit', {'id': session.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_session_new') }}">Create new</a>
{% endblock %}
