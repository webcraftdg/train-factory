{% extends 'base.html.twig' %}

{% block title %}Session{% endblock %}

{% block body %}
    <h1>Session</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ session.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ session.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ session.description }}</td>
            </tr>
            <tr>
                <th>Target</th>
                <td>{{ session.target }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ session.duration }}</td>
            </tr>
            <tr>
                <th>DateArchived</th>
                <td>{{ session.dateArchived ? session.dateArchived|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateCreate</th>
                <td>{{ session.dateCreate ? session.dateCreate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateUpdate</th>
                <td>{{ session.dateUpdate ? session.dateUpdate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_session_index') }}">back to list</a>

    <a href="{{ path('app_session_edit', {'id': session.id}) }}">edit</a>

    {{ include('session/_delete_form.html.twig') }}
{% endblock %}
