
<article class="flex h-full flex-col rounded-xl border border-slate-200
                bg-white p-5 shadow-sm transition-shadow
                hover:shadow-md"
    data-controller="archived"
    data-archived-context-name-value="{{ session.name}}"
                >

    {# Public cible #}
    <div class="mb-4 flex items-center justify-between gap-3">
        <span class="rounded-full bg-blue-100 px-3 py-1
                     text-xs font-medium text-blue-700">
            {{ session.target }}
        </span>
    </div>

    {# Titre et description #}
    <h2 class="mb-2 text-lg font-semibold text-slate-900">
        {{ session.name }}
    </h2>

    <p class="mb-5 line-clamp-3 text-sm text-slate-600">
        {{ session.description|default('Aucune description') }}
    </p>

    {# Informations #}
    <div class="mt-auto">
        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">

            <span class="flex items-center gap-1">
                Durée : {{ session.duration }} min
            </span>

            <span class="flex items-center gap-1">
                {{ session.blocks|length }} blocs
            </span>

        </div>

        {# Actions #}
        <div class="mt-4 flex items-center justify-end
                    border-t border-slate-100 pt-4">

            <a href="{{ path('app_session_download', {id: session.id}) }}"
               aria-label="Télécharger {{ session.name }}"
               title="Télécharger {{ session.name }}"
               onclick="event.stopPropagation()"
               class="inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50">

                <span data-controller="svg"
                      data-svg-name-value="download"
                      class="inline-flex items-center justify-center"
                      aria-hidden="true">
                </span>
            </a>
            <a href="{{ path('app_session_edit', {id: session.id}) }}"
               aria-label="Modifier {{ session.name }}"
               title="Modifier {{ session.name }}"
               onclick="event.stopPropagation()"
               class="inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50">

                <span data-controller="svg"
                      data-svg-name-value="edit"
                      class="inline-flex items-center justify-center"
                      aria-hidden="true">
                </span>
            </a>

            {% if (is_granted('ROLE_ADMIN')) %}
                <a href="{{ path('app_session_archived', {id: session.id}) }}"
                    data-action="click->archived#confirmDelete"
                    data-turbo-prefetch="false"
                    aria-label="Archiver {{ session.name }}"
                    title="Archiver {{ session.name }}"
                    class="inline-flex min-h-10 items-center gap-2
                            rounded-lg px-3 py-2 font-medium
                            text-orange-600 hover:bg-orange-50">
                    <span data-controller="svg"
                        data-svg-name-value="archive"
                        class="inline-flex  items-center justify-center"
                        aria-hidden="true">
                    </span>
                </a>
            {% endif %}

        </div>
    </div>
</article>
