
<header class="relative z-20 border-b border-slate-800
               bg-slate-900 text-white">

    {% set menu = main_menu() %}
    {% set currentRoute = app.request.attributes.get('_route') %}
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="flex min-h-16 items-center justify-between gap-4">

            {# Logo #}
            <a href="{{ path('app_session_index') }}"
               class="flex shrink-0 items-center gap-3">

                <span class="flex h-10 w-10 items-center justify-center
                             rounded-lg bg-blue-600 font-bold">
                    TF
                </span>

                <span class="text-xl font-bold tracking-tight">
                    TrainFactory
                </span>
            </a>

            {# Navigation desktop #}
            <nav class="hidden items-center gap-2 md:flex"
                 aria-label="Navigation principale">
                 <ul class="flex flex-col gap-1 md:flex-row md:items-center md:gap-2">
                    {% for item in main_menu() %}
                        <li>
                            <a href="{{ path(item.route) }}"
                            {% if currentRoute == item.route %}
                                aria-current="page"
                            {% endif %}
                            class="block rounded-lg px-3 py-2 text-sm
                                    transition-colors hover:bg-slate-800
                                    {{ currentRoute == item.route
                                        ? 'bg-slate-800 text-blue-300'
                                        : 'text-slate-200' }}">
                                {{ item.label | raw }}
                            </a>
                        </li>
                    {% endfor %}
                    <li>
                     {# Utilisateur et déconnexion desktop #}
                    <div class="hidden items-center gap-4 md:flex">

                        <span class="max-w-40 truncate text-sm text-slate-300"
                            title="{{ app.user.userIdentifier }}">
                            {{ app.user.userIdentifier }}
                        </span>

                        <a href="{{ path('app_logout') }}"
                        class="rounded-lg border border-slate-600
                                px-3 py-2 text-sm transition-colors
                                hover:border-red-400 hover:text-red-300">
                            Déconnexion
                        </a>
                    </div>
                    </li>
                </ul>
            </nav>

            {# Menu mobile natif #}
            <details class="group relative md:hidden">

                <summary class="flex h-11 w-11 cursor-pointer
                                list-none items-center justify-center
                                rounded-lg border border-slate-700
                                hover:bg-slate-800
                                focus-visible:outline-2
                                focus-visible:outline-blue-400
                                [&::-webkit-details-marker]:hidden"
                         aria-label="Ouvrir ou fermer le menu">

                    {# Icône hamburger #}
                    <svg class="h-6 w-6 group-open:hidden"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>

                    {# Icône fermeture #}
                    <svg class="hidden h-6 w-6 group-open:block"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6 6l12 12M18 6L6 18"/>
                    </svg>
                </summary>

                <div class="absolute right-0 top-full mt-3
                            w-64 max-w-[calc(100vw-2rem)]
                            rounded-xl border border-slate-700
                            bg-slate-900 p-3 shadow-xl">

                    <nav class="flex flex-col gap-1"
                         aria-label="Navigation mobile">

                        <a href="{{ path('app_session_index') }}"
                           class="rounded-lg px-3 py-3 text-sm
                                  hover:bg-slate-800">
                            Séances
                        </a>

                        <a href="#"
                           class="rounded-lg px-3 py-3 text-sm
                                  hover:bg-slate-800">
                            Blocs
                        </a>

                        <a href="#"
                           class="rounded-lg px-3 py-3 text-sm
                                  hover:bg-slate-800">
                            Exercices
                        </a>
                    </nav>

                    <div class="mt-3 border-t border-slate-700 pt-3">

                        <p class="break-all px-3 py-2 text-xs
                                  text-slate-400">
                            {{ app.user.userIdentifier }}
                        </p>

                        <a href="{{ path('app_logout') }}"
                           class="block rounded-lg px-3 py-3
                                  text-sm text-red-300
                                  hover:bg-slate-800">
                            Déconnexion
                        </a>
                    </div>

                </div>
            </details>

        </div>
    </div>
</header>
