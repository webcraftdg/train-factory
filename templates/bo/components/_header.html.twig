
<header
    data-controller="menu"
    data-action="keydown.esc@window->menu#closeOnEscape
                 click@window->menu#closeOnOutsideClick"
    class="relative z-20 bg-slate-900 text-white">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="flex min-h-16 flex-wrap items-center justify-between gap-4">

            {# Logo #}
            <a href="{{ path('bo_session_index') }}"
               class="flex items-center gap-3">
                <span class="rounded-lg bg-blue-600 px-3 py-2 font-bold">
                    TF
                </span>
                <span class="text-xl font-bold">
                    TrainFactory
                </span>
            </a>

            {# Bouton mobile #}
            <button
                type="button"
                data-menu-target="button"
                data-action="click->menu#toggle"
                aria-controls="main-navigation"
                aria-expanded="false"
                aria-label="Ouvrir le menu"
                class="rounded-lg border border-slate-700 p-2
                       hover:bg-slate-800 md:hidden">

                <svg class="h-6 w-6" fill="none"
                     stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>

            {# Navigation unique #}
            <nav
                id="main-navigation"
                data-menu-target="menu"
                aria-label="Navigation principale"
                class="hidden w-full flex-col gap-2
                       border-t border-slate-700 py-3
                       md:flex md:w-auto md:flex-row
                       md:items-center md:border-0 md:py-0">

                <ul class="flex flex-col gap-1
                           md:flex-row md:items-center md:gap-2">

                    {% for item in main_menu() %}
                        <li>
                            <a href="{{ path(item.route) }}"
                               class="block rounded-lg px-3 py-3
                                      text-sm hover:bg-slate-800
                                      md:py-2">
                                {{ item.label | raw}}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if app.user %}
                <div class="mt-2 border-t border-slate-700 pt-3
                            md:mt-0 md:ml-4 md:border-0 md:pt-0">

                    <span class="block break-all px-3 py-2
                                 text-xs text-slate-400 md:hidden">
                        {{ app.user.userIdentifier }}
                    </span>

                    <a href="{{ path('bo_logout') }}"
                       class="block rounded-lg px-3 py-3 text-sm
                              text-red-300 hover:bg-slate-800
                              md:py-2">
                        Déconnexion
                    </a>
                </div>
                {% endif %}
            </nav>

        </div>
    </div>
</header>
