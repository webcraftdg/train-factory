{% extends 'bo/base.html.twig' %}

{% block title %}Activity{% endblock %}

{% block body %}
    <h1>Activity</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ activity.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ activity.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ activity.description }}</td>
            </tr>
            <tr>
                <th>Objective</th>
                <td>{{ activity.objective }}</td>
            </tr>
            <tr>
                <th>Instruction</th>
                <td>{{ activity.instruction }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ activity.duration }}</td>
            </tr>
            <tr>
                <th>Position</th>
                <td>{{ activity.position }}</td>
            </tr>
            <tr>
                <th>DateArchived</th>
                <td>{{ activity.dateArchived ? activity.dateArchived|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateCreate</th>
                <td>{{ activity.dateCreate ? activity.dateCreate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateUpdate</th>
                <td>{{ activity.dateUpdate ? activity.dateUpdate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('bo_activity_index') }}">back to list</a>

    <a href="{{ path('bo_activity_edit', {'id': activity.id}) }}">edit</a>

    {{ include('bo/activity/_delete_form.html.twig') }}
{% endblock %}
