
{% extends 'bo/base.html.twig' %}

{% block body %}
<div class="flex min-h-[calc(100vh-8rem)] items-center justify-center px-4 py-8">

    <div class="grid w-full max-w-5xl overflow-hidden rounded-2xl
                bg-white shadow-xl lg:grid-cols-2">

        {# Panneau de présentation - desktop #}
        <div class="hidden flex-col justify-between
                    bg-slate-900 p-10 text-white lg:flex">

            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center
                            rounded-xl bg-blue-600 text-xl font-bold">
                    TF
                </div>

                <span class="text-2xl font-bold tracking-tight">
                    TrainFactory
                </span>
            </div>

            <div>
                <span class="mb-5 inline-block rounded-full
                             border border-blue-400/30 bg-blue-500/10
                             px-4 py-2 text-sm text-blue-300">
                    Votre espace d'entraînement
                </span>

                <h1 class="mb-6 text-4xl font-bold leading-tight">
                    Chaque séance
                    <span class="text-blue-400">
                        commence ici.
                    </span>
                </h1>

                <p class="max-w-sm leading-relaxed text-slate-300">
                    Créez, organisez et réutilisez vos séances
                    d'entraînement, quel que soit votre sport.
                </p>
            </div>

            <p class="text-sm text-slate-400">
                Organisez. Entraînez. Progressez.
            </p>
        </div>

        {# Formulaire de connexion #}
        <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12">

            {# Identité visible sur mobile #}
            <div class="mb-10 flex items-center gap-3 lg:hidden">
                <div class="flex h-11 w-11 items-center justify-center
                            rounded-xl bg-blue-600 font-bold text-white">
                    TF
                </div>
                <span class="text-xl font-bold text-slate-900">
                    TrainFactory
                </span>
            </div>

            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-900">
                    Bon retour !
                </h2>
                <p class="mt-2 text-sm text-slate-500">
                    Connectez-vous pour accéder à vos séances.
                </p>
            </div>

            {% if error %}
                <div role="alert"
                     class="mb-6 rounded-lg border border-red-200
                            bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ error.messageKey|trans(
                        error.messageData,
                        'security'
                    ) }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('bo_login') }}"
                  class="space-y-5">

                <div>
                    <label for="username"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Adresse e-mail
                    </label>

                    <input type="email"
                           id="username"
                           name="_username"
                           value="{{ last_username }}"
                           autocomplete="username"
                           required
                           autofocus
                           placeholder="vous@exemple.fr"
                           class="block w-full rounded-lg border
                                  border-slate-300 bg-white px-4 py-3
                                  text-slate-900 placeholder:text-slate-400
                                  focus:border-blue-500 focus:outline-none
                                  focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div>
                    <label for="password"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Mot de passe
                    </label>

                    <input type="password"
                           id="password"
                           name="_password"
                           autocomplete="current-password"
                           required
                           placeholder="Votre mot de passe"
                           class="block w-full rounded-lg border
                                  border-slate-300 bg-white px-4 py-3
                                  text-slate-900 placeholder:text-slate-400
                                  focus:border-blue-500 focus:outline-none
                                  focus:ring-2 focus:ring-blue-500/20">
                </div>

                <input type="hidden"
                       name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="flex min-h-12 w-full items-center
                               justify-center gap-2 rounded-lg
                               bg-blue-600 px-5 py-3 font-semibold
                               text-white transition-colors
                               hover:bg-blue-700
                               focus-visible:outline-2
                               focus-visible:outline-offset-2
                               focus-visible:outline-blue-600">
                    Se connecter
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <p class="mt-10 text-center text-xs text-slate-400">
                © {{ 'now'|date('Y') }} TrainFactory
            </p>

        </div>
    </div>
</div>
{% endblock %}

