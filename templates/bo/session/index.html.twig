
{% extends 'bo/base.html.twig' %}

{% block body %}
<section>
    <div class="mb-6 flex flex-col gap-4
                sm:flex-row sm:items-center sm:justify-between">

        <h1 class="text-2xl font-bold text-slate-900">
            Mes séances
        </h1>

        <a href="{{ path('bo_session_new') }}"
           class="inline-flex min-h-11 items-center justify-center
                  rounded-lg bg-blue-600 px-4 py-2
                  font-medium text-white hover:bg-blue-700">
            <span aria-hidden="true">+</span>
            Nouvelle séance
        </a>
    </div>

    <div class="grid grid-cols-1 gap-4
                md:grid-cols-2 xl:grid-cols-3">

        {% for session in sessions %}
            {% include 'bo/session/_card.html.twig'
                with { session: session } only %}
        {% else %}
            <p class="text-slate-500 md:col-span-2 xl:col-span-3">
                Aucune séance disponible.
            </p>
        {% endfor %}

    </div>
</section>
{% endblock %}
